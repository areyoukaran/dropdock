# --- Core ---
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
BASE_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://dropzone:dropzone@postgres:5432/dropzone

# --- Redis (cache, rate limiting, celery broker) ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (S3-compatible / MinIO locally) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=dropzone
S3_SECRET_KEY=dropzone123
S3_BUCKET=dropzone-drops
S3_REGION=us-east-1
S3_USE_SSL=false

# --- Rate limiting ---
RATE_LIMIT_UPLOADS_PER_HOUR=20
RATE_LIMIT_DOWNLOADS_PER_MINUTE=30

# --- Limits ---
MAX_FILE_SIZE_MB=500
MAX_DROP_SIZE_MB=1000
