# --- Core ---
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
BASE_URL=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql+asyncpg://dropdock:dropdock@postgres:5432/dropdock

# --- Redis (cache, rate limiting, celery broker) ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (S3-compatible / MinIO locally) ---
# Internal endpoint: used by the backend to talk to storage.
# In production (Backblaze B2 / Cloudflare R2 / AWS S3), this is the same
# as the public endpoint - there's no separate internal Docker network URL.
S3_ENDPOINT_URL=http://minio:9000
# Public endpoint: baked into signed download URLs handed to the browser.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=dropdock
S3_SECRET_KEY=dropdock123
S3_BUCKET=dropdock-drops
S3_REGION=us-east-1
S3_USE_SSL=false

# --- Rate limiting ---
RATE_LIMIT_UPLOADS_PER_HOUR=20
RATE_LIMIT_DOWNLOADS_PER_MINUTE=30
RATE_LIMIT_PASSWORD_ATTEMPTS_PER_MINUTE=5

# --- Limits ---
MAX_FILE_SIZE_MB=500
MAX_DROP_SIZE_MB=1000

# --- CORS ---
# Comma-separated list. Must include your deployed frontend URL in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Reverse proxy trust (production only) ---
# Comma-separated list of proxy IPs allowed to supply X-Forwarded-For for
# client-IP-based rate limiting. Leave empty for local dev - an empty list
# means X-Forwarded-For is never trusted, which is the safe default; a
# real deployment behind a reverse proxy (e.g. Render) must set this to
# that proxy's IP, or all traffic will appear to share one IP for rate
# limiting purposes.
TRUSTED_PROXY_IPS=

# --- Background expiry sweep ---
# Set to true only when NOT running a separate Celery worker/beat (e.g. on
# Render's free tier). Leave false for local Docker dev, which already
# runs real Celery beat - enabling both would sweep twice, redundantly.
ENABLE_BACKGROUND_SWEEP=false
BACKGROUND_SWEEP_INTERVAL_SECONDS=300
